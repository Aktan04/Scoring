@model IEnumerable<Scoring.Models.ScoringRule>
@using Scoring.Models

@{
    ViewData["Title"] = "Правила скоринга";
    // Меняем тип переменной для группировки со string на Enum
    ScoringParameter? currentParam = null; 
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm border">
        <div>
            <h2 class="fw-bold text-dark mb-1"><i class="bi bi-diagram-3-fill text-primary me-2"></i>Матрица скоринга</h2>
            <p class="text-muted mb-0">Настройка диапазонов и весовых баллов для автоматического принятия решений</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm rounded-pill fw-bold">
            <i class="bi bi-plus-lg me-1"></i> Добавить правило
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase small">Параметр</th>
                        <th class="py-3 text-secondary text-uppercase small">Диапазон (Мин - Макс)</th>
                        <th class="py-3 text-secondary text-uppercase small">Вес (Баллы)</th>
                        <th class="py-3 text-secondary text-uppercase small">Статус</th>
                        <th class="text-end pe-4 py-3 text-secondary text-uppercase small">Действия</th>
                    </tr>
                </thead>
                <tbody>
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-3"></i>
                            <p class="fs-5">Правила еще не настроены.</p>
                        </td>
                    </tr>
                }
                @foreach (var rule in Model)
                {
                    // Визуальное разделение групп параметров по Enum
                    if (currentParam != rule.Parameter)
                    {
                        <tr class="table-active bg-light bg-opacity-75">
                            <td colspan="5" class="ps-4 fw-bold text-primary small text-uppercase py-3">
                                <i class="bi bi-folder2-open me-2"></i> Группа: @Html.DisplayFor(modelItem => rule.Parameter)
                            </td>
                        </tr>
                        currentParam = rule.Parameter;
                    }

                    <tr>
                        <td class="ps-4 fw-bold text-dark">
                            @Html.DisplayFor(modelItem => rule.Parameter)
                        </td>
                        <td>
                            <span class="badge bg-white text-dark border border-secondary border-opacity-25 px-3 py-2 fs-6 shadow-sm rounded-pill">
                                @($"{rule.MinValue:0.##}") <span class="text-muted mx-2">—</span> @($"{rule.MaxValue:0.##}")
                            </span>
                        </td>
                        <td>
                            <span class="badge @(rule.WeightPoints > 0 ? "bg-success" : (rule.WeightPoints < 0 ? "bg-danger" : "bg-secondary")) px-3 py-2 fs-6 shadow-sm rounded-pill">
                                @(rule.WeightPoints > 0 ? "+" : "")@rule.WeightPoints
                            </span>
                        </td>
                        <td>
                            @if (rule.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 px-3 py-2 rounded-pill">
                                    <i class="bi bi-check-circle-fill me-1"></i> Активно
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary border-opacity-25 px-3 py-2 rounded-pill">
                                    <i class="bi bi-dash-circle-fill me-1"></i> Отключено
                                </span>
                            }
                        </td>
                        <td class="text-end pe-4">
                            <div class="d-flex justify-content-end gap-2">
                                <a asp-action="Edit" asp-route-id="@rule.Id" class="btn btn-sm btn-light border shadow-sm text-primary rounded-circle p-2" title="Редактировать">
                                    <i class="bi bi-pencil-fill"></i>
                                </a>
                                <form asp-action="Delete" asp-route-id="@rule.Id" method="post" onsubmit="return confirm('Вы уверены, что хотите удалить это правило скоринга?');">
                                    <button type="submit" class="btn btn-sm btn-light border shadow-sm text-danger rounded-circle p-2" title="Удалить">
                                        <i class="bi bi-trash-fill"></i>
                                    </button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>