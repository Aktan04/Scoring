@model IEnumerable<Scoring.Models.User>

@{
    ViewData["Title"] = "Сотрудники банка";
    var userRoles = ViewBag.UserRoles as Dictionary<int, string>;
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm border">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-people-fill text-primary me-2"></i>Персонал системы</h2>
            <p class="text-muted small mt-1 mb-0">Управление учетными записями Мейкеров и Чекеров</p>
        </div>
        <a asp-action="Create" class="btn btn-primary btn-lg shadow-sm rounded-pill fw-bold">
            <i class="bi bi-person-plus-fill me-1"></i> Зарегистрировать сотрудника
        </a>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 text-secondary text-uppercase small">ФИО сотрудника</th>
                            <th class="py-3 text-secondary text-uppercase small">Email (Логин)</th>
                            <th class="py-3 text-secondary text-uppercase small">Должность (Роль)</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var user in Model)
                        {
                            var role = userRoles != null && userRoles.ContainsKey(user.Id) ? userRoles[user.Id] : "Без роли";
                            <tr>
                                <td class="ps-4 fw-bold text-dark">
                                    <i class="bi bi-person-circle text-muted me-2"></i> @user.FullName
                                </td>
                                <td>@user.Email</td>
                                <td>
                                    <span class="badge px-3 py-2 rounded-pill @(role == "admin" ? "bg-danger" : (role == "maker" ? "bg-success" : "bg-warning text-dark"))">
                                        @(role == "admin" ? "Администратор" : (role == "maker" ? "Мейкер" : "Чекер"))
                                    </span>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>