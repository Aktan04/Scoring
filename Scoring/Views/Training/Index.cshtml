@using Scoring.Models
@{
    ViewData["Title"] = "Управление ML-моделью";
    var models = ViewBag.Models as List<ModelCoefficients> ?? new();
}

<div class="container py-4">
    <h2 class="mb-1">Управление скоринговой моделью</h2>
    <p class="text-muted mb-4">Обучение WOE-скоркарты, история версий, активация</p>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show">@TempData["Success"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show">@TempData["Error"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
    }

    <div class="row g-4 mb-4">
        <!-- Статистика датасета -->
        <div class="col-md-8">
            <div class="card h-100 shadow-sm">
                <div class="card-header fw-bold">📊 Обучающий датасет</div>
                <div class="card-body">
                    <div class="row text-center g-3">
                        <div class="col-4">
                            <div class="fs-2 fw-bold text-primary">@ViewBag.TotalRecords</div>
                            <div class="small text-muted">Всего записей</div>
                        </div>
                        <div class="col-4">
                            <div class="fs-2 fw-bold text-secondary">@ViewBag.SyntheticCount</div>
                            <div class="small text-muted">Синтетических</div>
                        </div>
                        <div class="col-4">
                            <div class="fs-2 fw-bold text-success">@ViewBag.RealCount</div>
                            <div class="small text-muted">Реальных заявок</div>
                        </div>
                    </div>
                    <hr />
                    <div class="d-flex justify-content-between align-items-center">
                        <span>Уровень дефолта (DR):</span>
                        <strong>@(((double)ViewBag.DefaultRate * 100).ToString("F1"))%</strong>
                    </div>
                    <div class="progress mt-2" style="height:8px">
                        <div class="progress-bar bg-danger"
                             style="width:@(((double)ViewBag.DefaultRate * 100).ToString("F1"))%"></div>
                    </div>
                    <small class="text-muted">Норма для розничного кредитования: 8–18%</small>
                </div>
            </div>
        </div>

        <!-- Кнопка обучения -->
        <div class="col-md-4">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-header fw-bold text-primary">🤖 Переобучить модель</div>
                <div class="card-body d-flex flex-column justify-content-between">
                    <p class="small">
                        Запускает полный ML-пайплайн:<br/>
                        WOE → Logistic Regression → Scorecard.<br/>
                        Новая версия не активируется автоматически.
                    </p>
                    <form asp-action="Train" method="post">
                        @Html.AntiForgeryToken()
                        <button type="submit" class="btn btn-primary w-100"
                                onclick="return confirm('Запустить обучение? Это займёт несколько секунд.')">
                            ▶ Запустить обучение
                        </button>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <!-- История моделей -->
    <div class="card shadow-sm">
        <div class="card-header fw-bold">📋 История версий модели</div>
        <div class="card-body p-0">
            @if (!models.Any())
            {
                <p class="p-3 text-muted">Моделей пока нет. Нажмите «Запустить обучение».</p>
            }
            else
            {
                <table class="table table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>ID</th>
                            <th>Дата обучения</th>
                            <th>Выборка</th>
                            <th>DR</th>
                            <th>AUC</th>
                            <th>Gini</th>
                            <th>Статус</th>
                            <th>Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var m in models)
                        {
                            <tr class="@(m.IsActive ? "table-success" : "")">
                                <td>#@m.Id</td>
                                <td>@m.TrainedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</td>
                                <td>@m.TrainSamples</td>
                                <td>@(m.DefaultRate.ToString("P1"))</td>
                                <td>
                                    <span class="fw-bold @(m.TrainAuc >= 0.7 ? "text-success" : "text-warning")">
                                        @m.TrainAuc.ToString("F3")
                                    </span>
                                </td>
                                <td>@m.Gini.ToString("F3")</td>
                                <td>
                                    @if (m.IsActive)
                                    {
                                        <span class="badge bg-success">✓ Активна</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">Неактивна</span>
                                    }
                                </td>
                                <td>
                                    <a asp-action="Details" asp-route-id="@m.Id"
                                       class="btn btn-sm btn-outline-primary me-1">Скоркарта</a>
                                    @if (!m.IsActive)
                                    {
                                        <form asp-action="Activate" asp-route-id="@m.Id"
                                              method="post" class="d-inline">
                                            @Html.AntiForgeryToken()
                                            <button class="btn btn-sm btn-outline-success"
                                                    onclick="return confirm('Активировать модель #@m.Id?')">
                                                Активировать
                                            </button>
                                        </form>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>

    <div class="alert alert-info mt-4 small">
        <strong>AUC</strong> (Area Under Curve) — качество разделения хороших и плохих клиентов.
        AUC ≥ 0.70 считается приемлемым, ≥ 0.75 — хорошим.<br/>
        <strong>Gini = 2×AUC − 1</strong> — нормированная мера дискриминации модели.
    </div>
</div>
