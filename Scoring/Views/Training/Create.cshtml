@model Scoring.Models.ModelCoefficients
@{
    ViewData["Title"] = $"Скоркарта модели #{Model.Id}";
    var iv = ViewBag.IV as Dictionary<string, double> ?? new();
}

<div class="container py-4">
    <div class="d-flex align-items-center gap-3 mb-4">
        <h2 class="mb-0">Скоркарта модели #@Model.Id</h2>
        @if (Model.IsActive)
        { <span class="badge bg-success fs-6">Активна</span> }
        else
        { <span class="badge bg-secondary fs-6">Неактивна</span> }
    </div>

    <!-- Метрики -->
    <div class="row g-3 mb-4">
        <div class="col-md-3"><div class="card text-center p-3 shadow-sm">
            <div class="fs-3 fw-bold text-success">@Model.TrainAuc.ToString("F3")</div>
            <div class="small text-muted">AUC</div>
        </div></div>
        <div class="col-md-3"><div class="card text-center p-3 shadow-sm">
            <div class="fs-3 fw-bold text-primary">@Model.Gini.ToString("F3")</div>
            <div class="small text-muted">Gini</div>
        </div></div>
        <div class="col-md-3"><div class="card text-center p-3 shadow-sm">
            <div class="fs-3 fw-bold">@Model.TrainSamples</div>
            <div class="small text-muted">Выборка</div>
        </div></div>
        <div class="col-md-3"><div class="card text-center p-3 shadow-sm">
            <div class="fs-3 fw-bold text-danger">@Model.DefaultRate.ToString("P1")</div>
            <div class="small text-muted">Уровень дефолта</div>
        </div></div>
    </div>

    <!-- IV -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header fw-bold">Information Value (предиктивная сила признаков)</div>
        <div class="card-body p-0">
            <table class="table table-sm table-hover mb-0">
                <thead class="table-light"><tr><th>Признак</th><th class="text-end">IV</th><th>Сила</th></tr></thead>
                <tbody>
                @foreach (var f in iv.OrderByDescending(x => x.Value))
                {
                    var (badge, label) = f.Value > 0.3 ? ("bg-success","Сильный")
                                      : f.Value > 0.1 ? ("bg-warning text-dark","Средний")
                                      : ("bg-secondary","Слабый");
                    <tr>
                        <td>@f.Key</td>
                        <td class="text-end fw-bold">@f.Value.ToString("F4")</td>
                        <td><span class="badge @badge">@label</span></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>

    <!-- Scorecard table -->
    <div class="card shadow-sm mb-4">
        <div class="card-header fw-bold">Таблица баллов скоркарты</div>
        <div class="card-body">
            <div class="row g-3">
                @* Возраст *@
                <div class="col-md-6">
                    <h6>Возраст <small class="text-muted fw-normal">(IV = @(iv.GetValueOrDefault("Возраст").ToString("F4")))</small></h6>
                    <table class="table table-sm table-bordered">
                        <tr><td>21–25</td><td class="text-end fw-bold @(Model.PtsAge21_25 < 0 ? "text-danger":"text-success")">@Model.PtsAge21_25.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>26–35</td><td class="text-end">@Model.PtsAge26_35.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>36–45</td><td class="text-end">@Model.PtsAge36_45.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>46–55</td><td class="text-end">@Model.PtsAge46_55.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>56–65</td><td class="text-end fw-bold @(Model.PtsAge56_65 < 0 ? "text-danger":"text-success")">@Model.PtsAge56_65.ToString("+#;-#;0") б.</td></tr>
                    </table>
                </div>
                @* Доход *@
                <div class="col-md-6">
                    <h6>Доход <small class="text-muted fw-normal">(IV = @(iv.GetValueOrDefault("Доход").ToString("F4")))</small></h6>
                    <table class="table table-sm table-bordered">
                        <tr><td>&lt; 30 000 сом</td><td class="text-end fw-bold @(Model.PtsIncomeLt30K < 0 ? "text-danger":"text-success")">@Model.PtsIncomeLt30K.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>30 000–60 000</td><td class="text-end">@Model.PtsIncome30_60K.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>60 000–100 000</td><td class="text-end">@Model.PtsIncome60_100K.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>&gt; 100 000</td><td class="text-end">@Model.PtsIncomeGt100K.ToString("+#;-#;0") б.</td></tr>
                    </table>
                </div>
                @* DTI *@
                <div class="col-md-6">
                    <h6>DTI — главный предиктор <small class="text-muted fw-normal">(IV = @(iv.GetValueOrDefault("DTI (Долговая нагрузка)").ToString("F4")))</small></h6>
                    <table class="table table-sm table-bordered">
                        <tr class="table-success"><td>&lt; 30%</td><td class="text-end fw-bold text-success">@Model.PtsDtiLt30.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>30–45%</td><td class="text-end">@Model.PtsDti30_45.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>45–60%</td><td class="text-end">@Model.PtsDti45_60.ToString("+#;-#;0") б.</td></tr>
                        <tr class="table-danger"><td>&gt; 60%</td><td class="text-end fw-bold text-danger">@Model.PtsDtiGt60.ToString("+#;-#;0") б.</td></tr>
                    </table>
                </div>
                @* Стаж *@
                <div class="col-md-6">
                    <h6>Стаж работы <small class="text-muted fw-normal">(IV = @(iv.GetValueOrDefault("Стаж работы").ToString("F4")))</small></h6>
                    <table class="table table-sm table-bordered">
                        <tr><td>&lt; 1 года</td><td class="text-end fw-bold text-danger">@Model.PtsExp0.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>1–3 года</td><td class="text-end">@Model.PtsExp1_3.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>3–7 лет</td><td class="text-end">@Model.PtsExp3_7.ToString("+#;-#;0") б.</td></tr>
                        <tr><td>&gt; 7 лет</td><td class="text-end text-success">@Model.PtsExpGt7.ToString("+#;-#;0") б.</td></tr>
                    </table>
                </div>
            </div>

            <div class="mt-3 p-3 bg-light rounded small">
                <strong>Параметры шкалы:</strong>
                Offset = @Model.ScaleOffset.ToString("F0") &nbsp;|&nbsp;
                Factor = @Model.Factor.ToString("F2") &nbsp;|&nbsp;
                Порог одобрения: ≥ @Model.ThresholdApprove &nbsp;|&nbsp;
                Порог ручной проверки: ≥ @Model.ThresholdReview
            </div>
        </div>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">← Назад</a>
</div>
