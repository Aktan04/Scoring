@model IEnumerable<Scoring.Models.LoanApplication>

@{
    ViewData["Title"] = "Очередь андеррайтинга";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm border">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-inbox-fill text-warning me-2"></i>Очередь ручной проверки</h2>
            <p class="text-muted small mt-1 mb-0">Заявки, по которым автоматический скоринг не смог принять решение</p>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                    <tr>
                        <th class="ps-4 py-3 text-secondary text-uppercase small">Дата создания</th>
                        <th class="py-3 text-secondary text-uppercase small">Заемщик</th>
                        <th class="py-3 text-secondary text-uppercase small">Продукт / Сумма</th>
                        <th class="py-3 text-secondary text-uppercase small">Оформил (Maker)</th>
                        <th class="text-end pe-4 py-3 text-secondary text-uppercase small">Действие</th>
                    </tr>
                    </thead>
                    <tbody>
                    @if (!Model.Any())
                    {
                        <tr><td colspan="5" class="text-center py-5 text-muted">В очереди нет заявок на ручную проверку. Отличная работа!</td></tr>
                    }
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td class="ps-4 fw-bold text-muted small">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                            <td>
                                <div class="fw-bold text-dark">@item.LastName @item.FirstName</div>
                                <div class="small text-muted font-monospace">ИНН: @item.Inn</div>
                            </td>
                            <td>
                                <div class="text-dark">@item.LoanProduct?.Name</div>
                                <div class="fw-bold text-primary">@item.Amount.ToString("N0") сом</div>
                            </td>
                            <td class="text-muted small">
                                <i class="bi bi-person-badge me-1"></i> @(item.Maker?.FullName ?? "Неизвестно")
                            </td>
                            <td class="text-end pe-4">
                                <a asp-action="ApplicationDetails" asp-route-id="@item.Id" class="btn btn-sm btn-warning fw-bold rounded-pill px-3 shadow-sm text-dark">
                                    Взять в работу
                                </a>
                            </td>
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>