@{
    ViewData["Title"] = "Доступ ограничен";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6 text-center">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden">
                <div class="bg-danger py-5">
                    <i class="bi bi-shield-lock-fill text-white display-1"></i>
                </div>
                <div class="card-body p-5">
                    <h2 class="fw-bold text-dark mb-3">Доступ ограничен</h2>
                    <p class="text-muted mb-4 fs-5">
                        У вашей учетной записи недостаточно прав для просмотра этой страницы. 
                        Этот раздел предназначен только для авторизованных сотрудников банка.
                    </p>
                    
                    <div class="alert alert-warning border-0 small text-start d-flex align-items-center mb-4">
                        <i class="bi bi-exclamation-triangle-fill fs-4 me-3"></i>
                        <div>
                            Если вы считаете, что это ошибка, пожалуйста, обратитесь к системному администратору 
                            или технической поддержке для расширения прав доступа.
                        </div>
                    </div>

                    <div class="d-grid gap-2">
                        <a asp-controller="Home" asp-action="Index" class="btn btn-outline-dark btn-lg px-4">
                            <i class="bi bi-house-door me-2"></i>Вернуться на главную
                        </a>
                        @if (User.Identity.IsAuthenticated)
                        {
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-grid">
                                <button type="submit" class="btn btn-link text-danger text-decoration-none">
                                    Войти под другой учетной записью
                                </button>
                            </form>
                        }
                    </div>
                </div>
            </div>
            
            <p class="mt-4 text-muted small">
                ID операции: @Guid.NewGuid().ToString().Substring(0, 8) | Код ошибки: 403 Forbidden
            </p>
        </div>
    </div>
</div>