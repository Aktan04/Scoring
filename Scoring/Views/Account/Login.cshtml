@model Scoring.Models.LoginViewModel

@{
    ViewData["Title"] = "Вход в систему";
    // Убираем стандартную навигацию/футер для страниц авторизации (опционально)
    // Layout = "_AuthLayout"; 
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden mt-5">
                <div class="card-header bg-primary text-white p-4 text-center border-0">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-shield-lock me-2"></i>Вход в систему</h3>
                    <p class="mb-0 text-white-50 small mt-1">Кредитный скоринг портал</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Login" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 text-center small fw-bold"></div>
                        <input type="hidden" asp-for="ReturnUrl" />

                        <div class="mb-4">
                            <label asp-for="Email" class="form-label fw-bold text-secondary">Email адрес</label>
                            <div class="input-group input-group-lg shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" class="form-control border-start-0 ps-0" placeholder="name@example.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Password" class="form-label fw-bold text-secondary">Пароль</label>
                            <div class="input-group input-group-lg shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-key text-muted"></i></span>
                                <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small mt-1 d-block"></span>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                <input asp-for="RememberMe" class="form-check-input" type="checkbox" id="rememberMe">
                                <label class="form-check-label text-muted" for="rememberMe">
                                    Запомнить меня
                                </label>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mb-3">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold shadow-sm">Войти</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light border-0 text-center py-3">
                    <span class="text-muted small">Нет аккаунта?</span>
                    <a asp-action="Register" class="text-decoration-none fw-bold ms-1">Зарегистрироваться</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}