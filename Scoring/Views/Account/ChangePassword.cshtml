@model Scoring.Models.ChangePasswordViewModel

@{
    ViewData["Title"] = "Смена пароля";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-white p-4 border-bottom text-center">
                    <h4 class="mb-0 fw-bold text-dark"><i class="bi bi-key text-primary me-2"></i>Смена пароля</h4>
                </div>
                <div class="card-body p-4 p-md-5 bg-light bg-opacity-50">
                    <form asp-action="ChangePassword" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3 fw-bold small"></div>

                        <div class="mb-3">
                            <label asp-for="OldPassword" class="form-label fw-bold text-secondary small text-uppercase">Текущий пароль</label>
                            <input asp-for="OldPassword" class="form-control form-control-lg" required />
                            <span asp-validation-for="OldPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="NewPassword" class="form-label fw-bold text-secondary small text-uppercase">Новый пароль</label>
                            <input asp-for="NewPassword" class="form-control form-control-lg" required />
                            <span asp-validation-for="NewPassword" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label fw-bold text-secondary small text-uppercase">Подтверждение</label>
                            <input asp-for="ConfirmPassword" class="form-control form-control-lg" required />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid mt-4">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold rounded-pill shadow-sm">Сменить пароль</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}