@model Scoring.Models.RegisterViewModel

@{
    ViewData["Title"] = "Регистрация";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-lg border-0 rounded-4 overflow-hidden mt-4">
                <div class="card-header bg-dark text-white p-4 text-center border-0">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-person-plus me-2"></i>Создание аккаунта</h3>
                    <p class="mb-0 text-white-50 small mt-1">Присоединяйтесь для получения кредитных услуг</p>
                </div>
                <div class="card-body p-4 p-md-5">
                    <form asp-action="Register" method="post">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small border-0"></div>

                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-bold text-secondary">ФИО полностью</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-person-badge text-muted"></i></span>
                                <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Например: Иванов Иван Иванович" required />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label fw-bold text-secondary">Email адрес</label>
                            <div class="input-group shadow-sm">
                                <span class="input-group-text bg-light border-end-0"><i class="bi bi-envelope text-muted"></i></span>
                                <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="name@example.com" required />
                            </div>
                            <span asp-validation-for="Email" class="text-danger small"></span>
                            <div class="form-text small">Этот email будет использоваться для входа в систему.</div>
                        </div>

                        <div class="row g-3 mb-4 mt-1">
                            <div class="col-sm-6">
                                <label asp-for="Password" class="form-label fw-bold text-secondary">Пароль</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-lock text-muted"></i></span>
                                    <input asp-for="Password" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                                </div>
                                <span asp-validation-for="Password" class="text-danger small"></span>
                            </div>
                            <div class="col-sm-6">
                                <label asp-for="ConfirmPassword" class="form-label fw-bold text-secondary">Подтверждение</label>
                                <div class="input-group shadow-sm">
                                    <span class="input-group-text bg-light border-end-0"><i class="bi bi-check2-all text-muted"></i></span>
                                    <input asp-for="ConfirmPassword" type="password" class="form-control border-start-0 ps-0" placeholder="••••••••" required />
                                </div>
                                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="alert alert-info border-0 small mt-2">
                            <i class="bi bi-info-circle me-1"></i> Нажимая кнопку «Зарегистрироваться», вы соглашаетесь на обработку персональных данных.
                        </div>

                        <div class="d-grid gap-2 mt-4">
                            <button type="submit" class="btn btn-dark btn-lg fw-bold shadow-sm">Зарегистрироваться</button>
                        </div>
                    </form>
                </div>
                <div class="card-footer bg-light border-0 text-center py-3">
                    <span class="text-muted small">Уже есть аккаунт?</span>
                    <a asp-action="Login" class="text-decoration-none fw-bold ms-1">Войти в систему</a>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}