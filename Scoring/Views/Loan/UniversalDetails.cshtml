@using Scoring.Models
@using System.Text.Json
@{
    ViewData["Title"] = "Детали заявки";

    var app      = ViewBag.Application  as LoanApplication;
    var scoring  = ViewBag.ScoringResult as ScoringResult;
    var history  = ViewBag.History      as List<ApplicationHistory> ?? new();
    var isChecker= User.IsInRole("checker");
    var isMaker  = User.IsInRole("maker");

    var statusColor = app?.Status switch
    {
        ApplicationStatus.Approved     => "success",
        ApplicationStatus.Rejected     => "danger",
        ApplicationStatus.ManualReview => "warning",
        ApplicationStatus.InScoring    => "info",
        _                              => "secondary"
    };

    var statusIcon = app?.Status switch
    {
        ApplicationStatus.Approved     => "bi-check-circle-fill",
        ApplicationStatus.Rejected     => "bi-x-circle-fill",
        ApplicationStatus.ManualReview => "bi-person-workspace",
        ApplicationStatus.InScoring    => "bi-hourglass-split",
        _                              => "bi-question-circle"
    };

    // Парсим детализацию скоринга
    Dictionary<string, string> scoringBins = new();
    if (scoring != null && !string.IsNullOrEmpty(scoring.RawResponseJson))
    {
        try
        {
            var root = JsonSerializer.Deserialize<JsonElement>(scoring.RawResponseJson);
            if (root.TryGetProperty("bins", out var bins))
                scoringBins = JsonSerializer.Deserialize<Dictionary<string, string>>(bins.GetRawText()) ?? new();
            else
                scoringBins = JsonSerializer.Deserialize<Dictionary<string, string>>(scoring.RawResponseJson) ?? new();
        }
        catch { }
    }

    bool isAntiFraud = scoringBins.ContainsKey("antiFraud") || scoringBins.ContainsKey("Антифрод");
}

<div class="container-fluid mt-4 mb-5 px-4">

    @* ── Хлебные крошки ── *@
    <nav class="mb-4">
        <ol class="breadcrumb bg-white p-3 rounded-4 shadow-sm border mb-0">
            <li class="breadcrumb-item">
                <a asp-controller="Loan" asp-action="Index" class="text-decoration-none fw-bold">
                    <i class="bi bi-table me-1"></i>База заявок
                </a>
            </li>
            <li class="breadcrumb-item active fw-bold text-muted">
                Заявка № @app?.Id.ToString().Substring(0, 8)
            </li>
        </ol>
    </nav>

    @* ── Шапка с баллом или статусом ── *@
    <div class="card border-0 shadow rounded-4 overflow-hidden mb-4">
        @if (scoring != null)
        {
            // Заявка прошла скоринг — показываем большой балл
            <div class="p-5 text-center text-white bg-@statusColor">
                <div class="row align-items-center justify-content-center g-4">
                    <div class="col-auto">
                        <div class="display-1 fw-bold lh-1">@scoring.TotalScore</div>
                        <div class="text-white-50 mt-1">скоринговый балл</div>
                    </div>
                    <div class="col-auto d-none d-md-block" style="width:1px;background:rgba(255,255,255,0.3);height:80px"></div>
                    <div class="col-auto text-start">
                        <div class="fs-4 fw-bold">
                            <i class="bi @statusIcon me-2"></i>
                            @Html.DisplayFor(m => app.Status)
                        </div>
                        <div class="text-white-50 small mt-1">
                            @app?.LastName @app?.FirstName &nbsp;·&nbsp; @app?.Inn
                        </div>
                        <div class="text-white-50 small">
                            @app?.LoanProduct?.Name &nbsp;·&nbsp; @app?.Amount.ToString("N0") сом &nbsp;·&nbsp; @app?.TermMonths мес.
                        </div>
                    </div>
                </div>
            </div>
        }
        else
        {
            // Заявка ещё без скоринга
            <div class="p-4 text-center border-bottom border-@(statusColor) border-4 bg-light">
                <span class="badge bg-@statusColor fs-6 px-4 py-2 rounded-pill @(app?.Status == ApplicationStatus.ManualReview ? "text-dark" : "")">
                    <i class="bi @statusIcon me-2"></i>@Html.DisplayFor(m => app.Status)
                </span>
                <div class="text-muted small mt-2">
                    @app?.LastName @app?.FirstName &nbsp;·&nbsp; @app?.LoanProduct?.Name
                </div>
            </div>
        }
    </div>

    <div class="row g-4">

        @* ══════════════════ ЛЕВАЯ КОЛОНКА ══════════════════ *@
        <div class="col-lg-5">

            @* ── Параметры кредита ── *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom px-4 py-3">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-cash-coin text-primary me-2"></i>Параметры кредита
                    </h6>
                </div>
                <div class="card-body px-4 py-3">
                    <div class="row g-3">
                        <div class="col-6">
                            <div class="text-muted small">Продукт</div>
                            <div class="fw-bold">@app?.LoanProduct?.Name</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Сумма</div>
                            <div class="fw-bold text-primary fs-5">@app?.Amount.ToString("N0") сом</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Срок</div>
                            <div class="fw-bold">@app?.TermMonths мес.</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Ставка</div>
                            <div class="fw-bold">@app?.LoanProduct?.InterestRate% годовых</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Дата подачи</div>
                            <div class="fw-bold">@app?.CreatedAt.ToString("dd.MM.yyyy")</div>
                        </div>
                        <div class="col-6">
                            <div class="text-muted small">Оформил</div>
                            <div class="fw-bold">@(app?.Maker?.FullName ?? "—")</div>
                        </div>
                    </div>
                </div>
            </div>

            @* ── Данные клиента ── *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom px-4 py-3">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-person-vcard text-primary me-2"></i>Данные клиента
                    </h6>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush rounded-4">
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between">
                            <span class="text-muted small">ФИО</span>
                            <span class="fw-bold text-end">@app?.LastName @app?.FirstName</span>
                        </li>
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between">
                            <span class="text-muted small">ИНН / Паспорт</span>
                            <span class="fw-bold text-end">@app?.Inn / @app?.PassportSerial</span>
                        </li>
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between">
                            <span class="text-muted small">Дата рождения</span>
                            <span class="fw-bold">@app?.BirthDate.ToString("dd.MM.yyyy")</span>
                        </li>
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between">
                            <span class="text-muted small">Семейное положение</span>
                            <span class="fw-bold">@Html.DisplayFor(m => app.MaritalStatus), @app?.DependentsCount иждив.</span>
                        </li>
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between">
                            <span class="text-muted small">Образование</span>
                            <span class="fw-bold">@Html.DisplayFor(m => app.EducationLevel)</span>
                        </li>
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between">
                            <span class="text-muted small">Занятость</span>
                            <span class="fw-bold text-end">@Html.DisplayFor(m => app.EmploymentType)<br>
                                <small class="text-muted fw-normal">@app?.EmployerIndustry, @app?.EmploymentYears лет</small>
                            </span>
                        </li>
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between">
                            <span class="text-muted small">Доход (осн. + доп.)</span>
                            <span class="fw-bold text-success">
                                @app?.IncomeAmount.ToString("N0") + @app?.AdditionalIncome.ToString("N0") сом
                            </span>
                        </li>
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between">
                            <span class="text-muted small">Активы</span>
                            <span>
                                @if (app?.HasRealEstate == true) { <span class="badge bg-info me-1">Недвижимость</span> }
                                @if (app?.HasVehicle == true)    { <span class="badge bg-secondary">Автомобиль</span> }
                                @if (app?.HasRealEstate == false && app?.HasVehicle == false) { <span class="text-muted small">Нет активов</span> }
                            </span>
                        </li>
                        <li class="list-group-item px-4 py-3 d-flex justify-content-between @(app?.HasPastDelinquencies == true ? "bg-danger bg-opacity-10" : "")">
                            <span class="text-muted small">Кредитная история</span>
                            <span class="fw-bold text-end">
                                @app?.ActiveLoansCount акт. кредитов<br>
                                @if (app?.HasPastDelinquencies == true)
                                {
                                    <small class="text-danger"><i class="bi bi-exclamation-triangle-fill me-1"></i>Были просрочки</small>
                                }
                                else
                                {
                                    <small class="text-success"><i class="bi bi-check-circle-fill me-1"></i>Просрочек нет</small>
                                }
                            </span>
                        </li>
                    </ul>
                </div>
            </div>

        </div>

        @* ══════════════════ ПРАВАЯ КОЛОНКА ══════════════════ *@
        <div class="col-lg-7">

            @* ── Детализация скоринга ── *@
            @if (scoring != null)
            {
                <div class="card border-0 shadow-sm rounded-4 mb-4">
                    <div class="card-header bg-white border-bottom px-4 py-3 d-flex justify-content-between align-items-center">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-calculator text-primary me-2"></i>Детализация скоринга
                        </h6>
                        <span class="badge bg-@statusColor @(app?.Status == ApplicationStatus.ManualReview ? "text-dark" : "") px-3 py-2">
                            @scoring.TotalScore баллов
                        </span>
                    </div>
                    <div class="card-body p-0">
                        @if (isAntiFraud)
                        {
                            <div class="p-4 d-flex align-items-center gap-3">
                                <i class="bi bi-shield-slash-fill text-danger fs-3"></i>
                                <div>
                                    <div class="fw-bold text-danger">Отказ по антифрод-фильтру</div>
                                    <div class="text-muted small">@(scoringBins.GetValueOrDefault("antiFraud") ?? scoringBins.GetValueOrDefault("Антифрод"))</div>
                                </div>
                            </div>
                        }
                        else if (scoringBins.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var kv in scoringBins)
                                {
                                    // Определяем цвет значка по знаку балла
                                    bool isPos = kv.Value.Contains("+");
                                    bool isNeg = kv.Value.Contains("-") && !kv.Value.StartsWith("{");
                                    <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                                        <span class="text-muted">@kv.Key</span>
                                        <span class="badge @(isPos ? "bg-success" : isNeg ? "bg-danger" : "bg-secondary") bg-opacity-75 px-3 py-2 rounded-pill">
                                            @kv.Value
                                        </span>
                                    </li>
                                }
                            </ul>
                            <div class="px-4 py-3 border-top bg-light d-flex justify-content-between align-items-center rounded-bottom-4">
                                <span class="text-muted small fw-bold">Шкала: ≥580 одобрено · 540–579 проверка · &lt;540 отказ</span>
                                <span class="fw-bold fs-5 text-@statusColor">@scoring.TotalScore б.</span>
                            </div>
                        }
                        else
                        {
                            <div class="p-4 text-muted text-center">Детализация недоступна</div>
                        }
                    </div>
                </div>
            }

            @* ── Форма решения чекера (только для ManualReview) ── *@
            @if (isChecker && app?.Status == ApplicationStatus.ManualReview)
            {
                <div class="card border-0 shadow-sm rounded-4 border-top border-warning border-4 mb-4">
                    <div class="card-header bg-white border-bottom px-4 py-3">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-person-workspace text-warning me-2"></i>Принять решение
                        </h6>
                    </div>
                    <div class="card-body p-4 bg-warning bg-opacity-10">
                        <form asp-controller="Admin" asp-action="ApproveManual" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@app.Id" />
                            <div class="mb-3">
                                <label class="form-label fw-bold small text-uppercase">Обоснование решения</label>
                                <textarea name="comment" class="form-control border-warning shadow-sm" rows="3"
                                          placeholder="Укажите причину одобрения или отказа..." required></textarea>
                            </div>
                            <div class="form-check mb-4 bg-danger bg-opacity-10 p-3 rounded-3 border border-danger border-opacity-25">
                                <input class="form-check-input ms-1" type="checkbox" id="addToBlacklist"
                                       name="addToBlacklist" value="true">
                                <label class="form-check-label fw-bold text-danger small ms-2" for="addToBlacklist">
                                    <i class="bi bi-shield-slash-fill me-1"></i>Отказать и внести ИНН в чёрный список
                                </label>
                            </div>
                            <div class="d-flex gap-2">
                                <button type="submit" name="isApproved" value="false"
                                        class="btn btn-danger w-100 fw-bold rounded-pill">
                                    <i class="bi bi-x-circle me-1"></i>Отказать
                                </button>
                                <button type="submit" name="isApproved" value="true"
                                        class="btn btn-success w-100 fw-bold rounded-pill">
                                    <i class="bi bi-check-circle me-1"></i>Одобрить
                                </button>
                            </div>
                        </form>
                    </div>
                </div>
            }

            @* ── Журнал изменений ── *@
            <div class="card border-0 shadow-sm rounded-4 mb-4">
                <div class="card-header bg-white border-bottom px-4 py-3">
                    <h6 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-clock-history text-primary me-2"></i>Журнал изменений
                    </h6>
                </div>
                <div class="card-body p-4">
                    @if (history.Any())
                    {
                        <div class="timeline ms-2">
                            @foreach (var item in history)
                            {
                                <div class="pb-4 border-start border-primary border-2 ps-4 position-relative">
                                    <div class="position-absolute bg-primary rounded-circle border border-white border-2"
                                         style="width:14px;height:14px;left:-8px;top:4px"></div>
                                    <div class="d-flex justify-content-between mb-2">
                                        <span class="fw-bold small">Статус изменён</span>
                                        <small class="text-muted">@item.ChangedAt.ToLocalTime().ToString("dd.MM.yy HH:mm")</small>
                                    </div>
                                    <div class="small mb-2 d-flex align-items-center gap-2">
                                        <span class="badge bg-light text-secondary border">@Html.DisplayFor(m => item.OldStatus)</span>
                                        <i class="bi bi-arrow-right text-muted"></i>
                                        <span class="badge @(item.NewStatus == ApplicationStatus.Approved ? "bg-success" : item.NewStatus == ApplicationStatus.Rejected ? "bg-danger" : "bg-warning text-dark")">
                                            @Html.DisplayFor(m => item.NewStatus)
                                        </span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(item.Comment))
                                    {
                                        <div class="p-3 bg-light rounded-3 border font-monospace small text-dark mb-2">
                                            "@item.Comment"
                                        </div>
                                    }
                                    <div class="text-muted small">
                                        <i class="bi bi-person-circle me-1"></i>@item.ChangedBy?.FullName
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="text-center py-3 text-muted">
                            <i class="bi bi-journal-x opacity-50 display-5 d-block mb-2"></i>
                            История изменений отсутствует
                        </div>
                    }
                </div>
            </div>

            @* ── Добавить в датасет (только для админа, только закрытые заявки) ── *@
            @if (User.IsInRole("admin") &&
                 (app?.Status == ApplicationStatus.Approved || app?.Status == ApplicationStatus.Rejected))
            {
                var alreadyInDataset = ViewBag.AlreadyInDataset as bool? ?? false;

                <div class="card border-0 shadow-sm rounded-4 mb-4 border-top border-4 @(alreadyInDataset ? "border-secondary" : "border-info")">
                    <div class="card-header bg-white border-bottom px-4 py-3 d-flex align-items-center justify-content-between">
                        <h6 class="fw-bold mb-0 text-dark">
                            <i class="bi bi-database-add text-info me-2"></i>Обучающий датасет
                        </h6>
                        @if (alreadyInDataset)
                        {
                            <span class="badge bg-success px-3 py-2">
                                <i class="bi bi-check-circle me-1"></i>Уже добавлена
                            </span>
                        }
                    </div>
                    <div class="card-body p-4 @(alreadyInDataset ? "bg-light" : "bg-info bg-opacity-10")">
                        @if (alreadyInDataset)
                        {
                            <p class="text-muted small mb-0">
                                <i class="bi bi-info-circle me-1"></i>
                                Эта заявка уже добавлена в обучающую выборку модели.
                            </p>
                        }
                        else
                        {
                            <p class="small text-muted mb-3">
                                Укажите реальный исход по этому кредиту. Данные пополнят обучающую выборку
                                и улучшат качество модели при следующем переобучении.
                            </p>
                            <div class="d-flex gap-2">
                                <form asp-controller="Training" asp-action="AddToDataset" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="applicationId" value="@app.Id" />
                                    <input type="hidden" name="isDefault" value="false" />
                                    <button type="submit" class="btn btn-success rounded-pill px-4 fw-bold"
                                            onclick="return confirm('Добавить как выплаченный кредит (не дефолт)?')">
                                        <i class="bi bi-check-circle me-1"></i>Кредит выплачен
                                    </button>
                                </form>
                                <form asp-controller="Training" asp-action="AddToDataset" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="applicationId" value="@app.Id" />
                                    <input type="hidden" name="isDefault" value="true" />
                                    <button type="submit" class="btn btn-danger rounded-pill px-4 fw-bold"
                                            onclick="return confirm('Добавить как дефолт? Клиент не выплатил кредит.')">
                                        <i class="bi bi-x-circle me-1"></i>Дефолт
                                    </button>
                                </form>
                            </div>
                        }
                    </div>
                </div>
            }

            @* ── Кнопки действий ── *@
            <div class="d-flex gap-3 flex-wrap">
                <a asp-controller="Loan" asp-action="Index"
                   class="btn btn-outline-secondary rounded-pill px-4 fw-bold">
                    <i class="bi bi-arrow-left me-1"></i>К базе заявок
                </a>
                @if (app?.Status == ApplicationStatus.Approved && (isMaker || isChecker))
                {
                    <a asp-controller="Loan" asp-action="DownloadContract" asp-route-id="@app.Id"
                       class="btn btn-success rounded-pill px-4 fw-bold">
                        <i class="bi bi-download me-2"></i>Скачать договор
                    </a>
                }
            </div>

        </div>
    </div>
</div>

<style>
    .timeline > div:last-child { border-left-color: transparent !important; }
</style>
