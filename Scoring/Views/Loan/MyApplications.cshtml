@model IEnumerable<LoanApplication>

@{
    ViewData["Title"] = "Мои кредитные заявки";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2><i class="bi bi-person-badge"></i> Личный кабинет клиента</h2>
        <a asp-action="Create" class="btn btn-primary">
            <i class="bi bi-plus-lg"></i> Новая заявка
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="card text-center p-5 shadow-sm">
            <div class="card-body">
                <i class="bi bi-folder2-open display-1 text-muted"></i>
                <h4 class="mt-3">У вас пока нет поданных заявок</h4>
                <p class="text-muted">Оформите свою первую заявку на кредит прямо сейчас.</p>
                <a asp-action="Create" class="btn btn-outline-primary">Подать заявку</a>
            </div>
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 col-lg-4 mb-4">
                    <div class="card h-100 shadow-sm border-0">
                        <div class="card-header @GetStatusClass(item.StatusId) text-white d-flex justify-content-between">
                            <span>Заявка от @item.CreatedAt.ToShortDateString()</span>
                            <strong>#@item.Id.ToString().Substring(0, 8)</strong>
                        </div>
                        <div class="card-body">
                            <h5 class="card-title text-primary">@item.Amount.ToString("N0") сом</h5>
                            <p class="card-text mb-1 text-muted">Тип: @item.LoanType</p>
                            <p class="card-text mb-3">
                                <strong>Статус:</strong> 
                                <span class="badge rounded-pill @GetStatusBadge(item.StatusId)">
                                    @item.Status?.Name
                                </span>
                            </p>
                            
                            <div class="d-grid">
                                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-outline-secondary btn-sm">
                                    Подробнее о решении
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@functions {
    // Вспомогательные функции для стилизации (можно вынести в хелперы)
    string GetStatusClass(int statusId) => statusId switch {
        3 => "bg-success", // Одобрено
        4 => "bg-danger",  // Отказ
        5 => "bg-warning", // На проверке
        _ => "bg-secondary"
    };

    string GetStatusBadge(int statusId) => statusId switch {
        3 => "bg-success",
        4 => "bg-danger",
        5 => "bg-warning text-dark",
        _ => "bg-light text-dark border"
    };
}