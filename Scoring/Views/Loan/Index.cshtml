@model IEnumerable<Scoring.Models.LoanApplication>
@using Scoring.Models

@{
    ViewData["Title"] = "Управление заявками";
}

<div class="container-fluid mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center mb-4 bg-white p-4 rounded-4 shadow-sm border">
        <div>
            <h2 class="fw-bold text-dark mb-0"><i class="bi bi-inbox-fill text-primary me-2"></i>Все кредитные заявки</h2>
            <p class="text-muted small mt-1 mb-0">Общий пул заявок банка</p>
        </div>
    </div>

    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card bg-primary text-white shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75">Всего заявок</h6>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.TotalCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-success text-white shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75">Одобрено (Авто)</h6>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.ApprovedCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-danger text-white shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75">Отказы</h6>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.RejectedCount</h2>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card bg-warning text-dark shadow-sm border-0 rounded-4">
                <div class="card-body p-4">
                    <h6 class="text-uppercase small fw-bold opacity-75">На проверке</h6>
                    <h2 class="display-5 fw-bold mb-0">@ViewBag.PendingCount</h2>
                </div>
            </div>
        </div>
    </div>

    <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th class="ps-4 py-3 text-secondary text-uppercase small">Дата</th>
                            <th class="py-3 text-secondary text-uppercase small">ФИО Клиента</th>
                            <th class="py-3 text-secondary text-uppercase small">Сумма (сом)</th>
                            <th class="py-3 text-secondary text-uppercase small">Продукт</th>
                            <th class="py-3 text-secondary text-uppercase small">Статус</th>
                            <th class="text-end pe-4 py-3 text-secondary text-uppercase small">Действия</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!Model.Any())
                        {
                            <tr><td colspan="6" class="text-center py-5 text-muted">Список заявок пуст</td></tr>
                        }
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4 fw-bold text-muted small">@item.CreatedAt.ToString("dd.MM.yyyy HH:mm")</td>
                                <td class="fw-bold text-dark">@item.LastName @item.FirstName</td>
                                <td class="fw-bold text-primary">@item.Amount.ToString("N0")</td>
                                <td>@item.LoanProduct?.Name</td>
                                <td>
                                    <span class="badge px-3 py-2 rounded-pill @(item.Status == ApplicationStatus.Approved ? "bg-success" : 
                                                                                (item.Status == ApplicationStatus.Rejected ? "bg-danger" : 
                                                                                (item.Status == ApplicationStatus.ManualReview ? "bg-warning text-dark" : "bg-info")))">
                                        @Html.DisplayFor(modelItem => item.Status)
                                    </span>
                                </td>
                                <td class="text-end pe-4">
                                    <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-light border shadow-sm text-primary rounded-pill px-3 fw-bold">
                                        Просмотр
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>