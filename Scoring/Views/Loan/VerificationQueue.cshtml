@model IEnumerable<LoanApplication>

<div class="container">
    <h2 class="mb-4"><i class="bi bi-clipboard-check"></i> Очередь на верификацию</h2>
    
    @if (!Model.Any())
    {
        <div class="alert alert-info">На данный момент заявок для ручной проверки нет.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in Model)
            {
                <div class="col-md-6 mb-3">
                    <div class="card border-warning shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">@item.LastName @item.FirstName</h5>
                            <p class="card-text">
                                <strong>Сумма:</strong> @item.Amount.ToString("N0") сом <br />
                                <strong>Доход:</strong> @item.IncomeAmount.ToString("N0") сом <br />
                                <strong>ИНН:</strong> @item.Inn
                            </p>
                            
                            <form asp-action="ApproveManual" method="post">
                                <input type="hidden" name="id" value="@item.Id" />
                                <div class="mb-2">
                                    <input type="text" name="comment" class="form-control form-control-sm" placeholder="Причина решения..." required />
                                </div>
                                <div class="btn-group w-100">
                                    <button type="submit" name="isApproved" value="true" class="btn btn-success">Одобрить</button>
                                    <button type="submit" name="isApproved" value="false" class="btn btn-danger">Отклонить</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>