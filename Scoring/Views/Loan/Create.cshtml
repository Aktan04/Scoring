@model Scoring.Models.LoanApplication

@{
    ViewData["Title"] = "Оформление кредита";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-lg border-0 rounded-4">
                <div class="card-header bg-primary text-white p-4 text-center rounded-top-4">
                    <h3 class="mb-0 fw-bold"><i class="bi bi-wallet2 me-2"></i>Заявка на кредит</h3>
                    <p class="mb-0 text-white-50 small">Заполните данные для автоматического скоринга</p>
                </div>
                <div class="card-body p-5">
                    <form asp-action="Create" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                        <h5 class="fw-bold text-secondary border-bottom pb-2 mb-4">Параметры кредита</h5>

                        <div class="mb-4">
                            <label asp-for="LoanProductId" class="form-label fw-bold">Выберите кредитный продукт</label>
                            <select asp-for="LoanProductId" class="form-select form-select-lg" asp-items="ViewBag.Products" required>
                                <option value="">-- Выберите продукт --</option>
                            </select>
                            <span asp-validation-for="LoanProductId" class="text-danger small"></span>
                        </div>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="Amount" class="form-label fw-bold">Желаемая сумма (сом)</label>
                                <div class="input-group">
                                    <input asp-for="Amount" type="number" class="form-control form-control-lg" placeholder="Например: 150000" required />
                                </div>
                                <span asp-validation-for="Amount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="TermMonths" class="form-label fw-bold">Срок кредита (мес.)</label>
                                <input asp-for="TermMonths" type="number" class="form-control form-control-lg" placeholder="От 3 до 60" required />
                                <span asp-validation-for="TermMonths" class="text-danger small"></span>
                            </div>
                        </div>

                        <h5 class="fw-bold text-secondary border-bottom pb-2 mb-4 mt-5">Личные и финансовые данные</h5>

                        <div class="row g-4 mb-4">
                            <div class="col-md-6">
                                <label asp-for="FirstName" class="form-label fw-bold">Имя</label>
                                <input asp-for="FirstName" class="form-control" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="LastName" class="form-label fw-bold">Фамилия</label>
                                <input asp-for="LastName" class="form-control" readonly />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="Inn" class="form-label fw-bold">ИНН</label>
                                <input asp-for="Inn" class="form-control" placeholder="14 символов" required />
                                <span asp-validation-for="Inn" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="BirthDate" class="form-label fw-bold">Дата рождения</label>
                                <input asp-for="BirthDate" type="date" class="form-control" required />
                                <span asp-validation-for="BirthDate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="IncomeAmount" class="form-label fw-bold">Ежемесячный доход (сом)</label>
                                <input asp-for="IncomeAmount" type="number" class="form-control" required />
                                <span asp-validation-for="IncomeAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="EmploymentYears" class="form-label fw-bold">Стаж работы (лет)</label>
                                <input asp-for="EmploymentYears" type="number" step="0.5" class="form-control" required />
                                <span asp-validation-for="EmploymentYears" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="d-grid gap-2 mt-5">
                            <button type="submit" class="btn btn-primary btn-lg fw-bold">Отправить на проверку</button>
                            <a asp-action="MyApplications" class="btn btn-light">Отмена</a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}