@model LoanApplication

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-8">
            <div class="card shadow border-warning">
                <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                    <h4 class="mb-0"><i class="bi bi-clock-history"></i> Заявка в обработке</h4>
                    <span class="badge bg-dark">ID: @Model.Id.ToString().Substring(0,8)</span>
                </div>
                <div class="card-body">
                    <div class="alert alert-secondary">
                        <strong>Статус: @Model.Status?.Name</strong>. 
                        Результаты автоматического скоринга еще не сформированы. Пожалуйста, подождите или свяжитесь с поддержкой.
                    </div>

                    <h5 class="border-bottom pb-2">Данные анкеты</h5>
                    <div class="row mb-3">
                        <div class="col-6 text-muted">ФИО клиента:</div>
                        <div class="col-6 fw-bold">@Model.LastName @Model.FirstName</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6 text-muted">Сумма кредита:</div>
                        <div class="col-6 fw-bold">@Model.Amount.ToString("N0") сом</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6 text-muted">Тип кредита:</div>
                        <div class="col-6">@Model.LoanType</div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-6 text-muted">Дата подачи:</div>
                        <div class="col-6">@Model.CreatedAt.ToString("g")</div>
                    </div>

                    <div class="d-grid mt-4">
                        <a asp-action="MyApplications" class="btn btn-outline-primary">Вернуться к списку</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>