@{
    ViewData["Title"] = "Кредиты онлайн";
}

<div class="px-4 py-5 my-5 text-center bg-white rounded-4 shadow-sm border">
    <i class="bi bi-rocket-takeoff display-1 text-primary mb-4"></i>
    <h1 class="display-4 fw-bold text-dark">Моментальный кредитный скоринг</h1>
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4 text-muted">Получите решение по кредиту за 1 минуту. Наша автоматизированная система анализирует данные и подбирает лучшие условия без визита в банк.</p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            @if (User.Identity.IsAuthenticated)
            {
                if (User.IsInRole("user"))
                {
                    <a asp-controller="Loan" asp-action="Create" class="btn btn-primary btn-lg px-4 gap-3 shadow">
                        <i class="bi bi-wallet2 me-2"></i>Оформить кредит
                    </a>
                    <a asp-controller="Loan" asp-action="MyApplications" class="btn btn-outline-secondary btn-lg px-4">
                        Мои заявки
                    </a>
                }
                else
                {
                    <a asp-controller="Loan" asp-action="Dashboard" class="btn btn-dark btn-lg px-4 gap-3 shadow">
                        <i class="bi bi-speedometer2 me-2"></i>Перейти в панель управления
                    </a>
                }
            }
            else
            {
                <a asp-controller="Account" asp-action="Register" class="btn btn-primary btn-lg px-4 gap-3 shadow">
                    Стать клиентом
                </a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-outline-secondary btn-lg px-4">
                    Войти в кабинет
                </a>
            }
        </div>
    </div>
</div>

<div class="row g-4 py-5 row-cols-1 row-cols-lg-3">
    <div class="col d-flex align-items-start">
        <div class="icon-square text-bg-light bg-primary bg-opacity-10 text-primary d-inline-flex align-items-center justify-content-center fs-3 flex-shrink-0 me-3 rounded-3 p-3">
            <i class="bi bi-lightning-charge-fill"></i>
        </div>
        <div>
            <h3 class="fs-5 fw-bold text-dark">Быстрое решение</h3>
            <p class="text-muted small">Интеллектуальная матрица скоринга оценивает сотни параметров в реальном времени и выдает мгновенный ответ.</p>
        </div>
    </div>
    <div class="col d-flex align-items-start">
        <div class="icon-square text-bg-light bg-success bg-opacity-10 text-success d-inline-flex align-items-center justify-content-center fs-3 flex-shrink-0 me-3 rounded-3 p-3">
            <i class="bi bi-shield-check"></i>
        </div>
        <div>
            <h3 class="fs-5 fw-bold text-dark">Безопасно и надежно</h3>
            <p class="text-muted small">Ваши данные защищены современными протоколами шифрования. Встроенная система антифрода исключает мошенничество.</p>
        </div>
    </div>
    <div class="col d-flex align-items-start">
        <div class="icon-square text-bg-light bg-warning bg-opacity-10 text-warning d-inline-flex align-items-center justify-content-center fs-3 flex-shrink-0 me-3 rounded-3 p-3">
            <i class="bi bi-file-earmark-pdf-fill"></i>
        </div>
        <div>
            <h3 class="fs-5 fw-bold text-dark">Оформление онлайн</h3>
            <p class="text-muted small">При положительном решении вы автоматически получаете сформированный кредитный договор в личном кабинете.</p>
        </div>
    </div>
</div>