@{
    ViewData["Title"] = "Внутренний портал";
}

<div class="px-4 py-5 my-5 text-center bg-white rounded-4 shadow-sm border">
    <i class="bi bi-bank display-1 text-primary mb-4"></i>
    <h1 class="display-4 fw-bold text-dark">SmartScoring LOS</h1>
    <div class="col-lg-6 mx-auto">
        <p class="lead mb-4 text-muted">
            Внутренняя система автоматизированного кредитного скоринга и андеррайтинга ОАО «Технический Банк».
        </p>
        <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-controller="Loan" asp-action="Dashboard" class="btn btn-primary btn-lg px-4 gap-3 shadow-sm rounded-pill fw-bold">
                    <i class="bi bi-speedometer2 me-2"></i>Перейти к работе
                </a>
            }
            else
            {
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-lg px-5 shadow-sm rounded-pill fw-bold">
                    Войти в систему
                </a>
            }
        </div>
    </div>
</div>