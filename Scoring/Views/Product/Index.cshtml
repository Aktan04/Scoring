@model IEnumerable<Scoring.Models.LoanProduct>

@{
    ViewData["Title"] = "Кредитные продукты";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary"><i class="bi bi-briefcase"></i> Кредитные продукты</h2>
            <p class="text-muted">Управление условиями кредитования и процентными ставками</p>
        </div>
        <a asp-action="Create" class="btn btn-primary shadow-sm">
            <i class="bi bi-plus-lg"></i> Новый продукт
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="alert alert-secondary text-center py-4 border-0 shadow-sm">
            <i class="bi bi-inbox fs-3 d-block mb-2"></i>
            Нет доступных кредитных продуктов. Добавьте первый продукт.
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var p in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 shadow-sm border-0 @(p.IsActive ? "border-top border-primary border-4" : "border-top border-secondary border-4 bg-light")">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h5 class="card-title fw-bold text-dark mb-0">@p.Name</h5>
                                @if (p.IsActive)
                                {
                                    <span class="badge bg-success px-2 py-1">Активен</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary px-2 py-1">Архив</span>
                                }
                            </div>
                            
                            <h3 class="my-3 text-primary">@p.InterestRate.ToString("G29")% <span class="fs-6 text-muted fw-normal">годовых</span></h3>
                            
                            <ul class="list-unstyled text-muted small mb-4">
                                <li class="mb-2 d-flex justify-content-between border-bottom pb-1">
                                    <span>Мин. сумма:</span> 
                                    <strong class="text-dark">@p.MinAmount.ToString("N0") сом</strong>
                                </li>
                                <li class="mb-2 d-flex justify-content-between border-bottom pb-1">
                                    <span>Макс. сумма:</span> 
                                    <strong class="text-dark">@p.MaxAmount.ToString("N0") сом</strong>
                                </li>
                            </ul>
                        </div>
                        <div class="card-footer bg-white border-0 pt-0 pb-3">
                            <div class="d-flex gap-2">
                                <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-outline-primary w-100 btn-sm">
                                    <i class="bi bi-pencil"></i> Настроить
                                </a>
                                <form asp-action="Delete" asp-route-id="@p.Id" method="post" class="w-100" 
                                      onsubmit="return confirm('Вы уверены? Если по продукту есть заявки, он будет перемещен в Архив.');">
                                    <button type="submit" class="btn btn-outline-danger w-100 btn-sm">
                                        <i class="bi bi-trash"></i> Удалить
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>