@model Scoring.Models.LoanProduct

@{
    ViewData["Title"] = "Настройка продукта";
}

<div class="container mt-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card shadow-sm border-0 border-top border-primary border-4">
                <div class="card-header bg-white py-3">
                    <h5 class="mb-0 fw-bold"><i class="bi bi-sliders text-primary me-2"></i> Настройка продукта: @Model.Name</h5>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Edit" method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-4">
                            <label asp-for="Name" class="form-label fw-bold">Название продукта</label>
                            <input asp-for="Name" class="form-control form-control-lg" required />
                            <span asp-validation-for="Name" class="text-danger small"></span>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="MinAmount" class="form-label fw-bold">Мин. сумма (сом)</label>
                                <input asp-for="MinAmount" type="number" step="1000" class="form-control" required />
                                <span asp-validation-for="MinAmount" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6">
                                <label asp-for="MaxAmount" class="form-label fw-bold">Макс. сумма (сом)</label>
                                <input asp-for="MaxAmount" type="number" step="1000" class="form-control" required />
                                <span asp-validation-for="MaxAmount" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row g-3 mb-4">
                            <div class="col-md-6">
                                <label asp-for="InterestRate" class="form-label fw-bold">Процентная ставка (%)</label>
                                <div class="input-group">
                                    <input asp-for="InterestRate" type="number" step="0.1" class="form-control" required />
                                    <span class="input-group-text">%</span>
                                </div>
                                <span asp-validation-for="InterestRate" class="text-danger small"></span>
                            </div>
                            <div class="col-md-6 d-flex align-items-end">
                                <div class="form-check form-switch mb-2">
                                    <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitchEdit">
                                    <label class="form-check-label fw-bold ms-2" for="isActiveSwitchEdit">Доступен для выдачи</label>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-info small border-0">
                            <i class="bi bi-info-circle me-1"></i> Изменение условий продукта не затронет уже поданные и одобренные заявки.
                        </div>

                        <hr class="my-4">

                        <div class="d-flex justify-content-between">
                            <a asp-action="Index" class="btn btn-light px-4">Отмена</a>
                            <button type="submit" class="btn btn-primary px-5">Сохранить изменения</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}